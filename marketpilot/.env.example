# Optional: set this to a registered Deriv app's public WebSocket URL.
# The official public endpoint is used when this is not set.
NEXT_PUBLIC_DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# Supabase Auth and profile storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase secret key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
