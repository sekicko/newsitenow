# Supabase Auth and profile storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only; use either key name. Required for payments and phone-number sign-in.
SUPABASE_SECRET_KEY=sb_secret_...
# Existing deployments may use this legacy name instead:
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only MegaPay credentials for Kenya M-Pesa deposits
MEGAPAY_API_KEY=
MEGAPAY_ACCOUNT_EMAIL=
